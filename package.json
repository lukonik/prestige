{
  "name": "prestigia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TypeScript packages maintained with TanStack Config conventions.",
  "license": "MIT",
  "author": "Luka Onikadze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukonik/prestigia.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "build": "nx affected --target=build",
    "build:all": "nx run-many --target=build",
    "changeset": "changeset",
    "changeset:publish": "pnpm build:all && changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
    "clean": "nx run-many --target=clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx affected --target=test:eslint",
    "preview": "pnpm build:all && pkg-pr-new publish --pnpm --compact './packages/*' --no-template",
    "test": "pnpm test:ci",
    "test:ci": "pnpm format:check && nx run-many --targets=test:eslint,test:types,test:lib,build,test:build",
    "test:pr": "pnpm format:check && nx affected --targets=test:eslint,test:types,test:lib,build,test:build",
    "typecheck": "nx affected --target=test:types"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@tanstack/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nx": "catalog:",
    "pkg-pr-new": "catalog:",
    "premove": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
