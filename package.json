{
  "name": "root",
  "private": true,
  "description": "",
  "keywords": [
    "prestige",
    "documentation",
    "static-site-generator",
    "markdown",
    "mdx",
    "react",
    "tanstack-start",
    "tanstack-router",
    "vite"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukonik/prestigia.git"
  },
  "scripts": {
    "dev": "pnpm run --filter @prestigia/docs dev",
    "play": "pnpm run --filter @prestigia/docs play",
    "play:build": "pnpm run --filter @prestigia/docs play:build",
    "play:preview": "pnpm run --filter @prestigia/docs play:preview",
    "build": "pnpm run --filter @prestigia/docs build",
    "docs:publish": "pnpm --filter @prestigia/docs publish",
    "cli:publish": "pnpm --filter @prestigia/cli publish",
    "test": "pnpm run --filter @prestigia/docs test",
    "coverage": "pnpm run --filter @prestigia/docs test --coverage",
    "typecheck": "pnpm run --filter @prestigia/docs typecheck",
    "prepare": "husky",
    "build:all": "pnpm -p build",
    "test:all": "pnpm -p test",
    "skills:validate": "pnpm --filter @prestigia/docs skills:validate",
    "skills:stale": "pnpm --filter @prestigia/docs skills:stale",
    "skills:sources": "node scripts/check-skill-source-changes.mjs",
    "skills:pack": "pnpm --filter @prestigia/docs skills:pack",
    "release-v": "pnpm --filter @prestigia/docs release-v",
    "docs": "pnpm run --filter docs dev",
    "install:template": "cd template && pnpm install --no-lockfile --ignore-workspace",
    "empty:release": "git commit --allow-empty -m \"fix: trigger release\"",
    "docs:build": "pnpm run --filter docs build"
  },
  "intent": {
    "skills": [
      "workspace:@prestigia/docs"
    ],
    "exclude": [
      "*#experimental-*"
    ]
  },
  "dependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "semantic-release": "catalog:"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  },
  "packageManager": "pnpm@11.24.0",
  "version": "0.1.4"
}
