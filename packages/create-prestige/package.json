  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "giget": "^3.3.1",
    "magicast": "^0.5.4",
    "nypm": "^0.6.9",
    "pathe": "catalog:",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
