{
  "name": "@prestigia/docs",
  "version": "0.7.1",
  "description": "Prestigia documentation package and versioned Agent Skills.",
  "license": "MIT",
  "author": "Luka Onikadze",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "!skills/_artifacts"
  ],
  "keywords": [
    "documentation",
    "agent-skills",
    "tanstack-intent"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukonik/prestigia.git",
    "directory": "packages/docs"
  },
  "homepage": "https://github.com/lukonik/prestigia#readme",
  "bugs": {
    "url": "https://github.com/lukonik/prestigia/issues"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "premove dist",
    "skills:pack": "node ../../scripts/check-package-skills.mjs",
    "skills:sources": "node ../../scripts/check-skill-source-changes.mjs",
    "skills:stale": "intent stale",
    "skills:validate": "intent validate --check",
    "test:build": "publint --strict --pack=false && attw --pack --profile esm-only .",
    "test:eslint": "eslint --concurrency=auto src tests tsdown.config.ts",
    "test:lib": "vitest run",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:"
  },
  "dependencies": {
    "@tanstack/markdown": "catalog:"
  }
}
