{
  "name": "@prestigia/docs",
  "version": "0.0.3",
  "description": "Prestigia documentation package.",
  "license": "MIT",
  "author": "Luka Onikadze",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukonik/prestigia.git",
    "directory": "packages/prestige"
  },
  "homepage": "https://github.com/lukonik/prestigia#readme",
  "bugs": {
    "url": "https://github.com/lukonik/prestigia/issues"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "premove dist",
    "test:build": "publint --strict && attw --pack --profile esm-only .",
    "test:eslint": "eslint --concurrency=auto src tests tsdown.config.ts",
    "test:lib": "vitest run",
    "test:types": "tsc --noEmit"
  }
}
